# ============================================
# Atlas Travel AI - root .gitignore
# Covers: frontend (Next.js) + backend (Python/FastAPI)
# ============================================

# ---------- Secrets & environment ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Python / backend ----------
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------- Datasets (licences! never commit raw data) ----------
backend/data/raw/
backend/data/processed/*.jsonl
backend/data/training/*.jsonl
# keep small example files that are safe to share
!backend/data/processed/*.example.jsonl
!backend/data/training/*.example.jsonl

# ---------- Vector DB & model artefacts ----------
backend/chroma_db/
backend/models/
backend/artifacts/
*.safetensors
*.bin
*.pt
*.pth
*.gguf
checkpoint-*/

# Hugging Face / model caches
.cache/
huggingface/

# ---------- Node / frontend ----------
node_modules/
.pnp
.pnp.js
.yarn/
frontend/.next/
frontend/out/
frontend/build/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts
.vercel

# ---------- Logs & test output ----------
*.log
logs/
coverage/

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp